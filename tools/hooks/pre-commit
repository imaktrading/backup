#!/bin/sh
# iMak Trading Japan - Pre-commit hook (tracked source)
#
# .git/hooks/ は git 管理外なので、本ファイルが正本。
# 新規環境セットアップ時:
#   cp tools/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# 役割:
#   (1) 本元 worktree (C:/dev/iMak/) の master 固定 — 5/3, 5/4 朝事故の物理再発防止
#   (2) **その worktree の担当分**テスト走行、失敗時は commit 拒否
#       (2026-08-12 まで monorepo 全体を走らせており、linked worktree では他人の stale な
#        テストで常に赤 = gate が最初から機能していなかった)

set -e

# ============================================================================
# (1) 本元 worktree の master 固定 (5/3, 5/4 朝事故 物理再発防止)
# ============================================================================
# 5/3 朝: master → feature/gshock-anti-bot-resilience checkout で post_title_fix.py 等の
#         uncommitted が working tree から退避された (commit 済で復元可だった)
# 5/4 朝: master → feature/montbell-catalog checkout で同型再発、HQ の commit が誤 branch に積まれた
#
# ドキュメント警告 (.PROJECT_LOCKED.md / CLAUDE.md / memory) のみでは防げない (二度同型事故)
# → pre-commit で物理的に commit を拒否することで、誤 branch での作業を強制発見

WORKTREE_TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)

# 本元 worktree かどうか判定 (パス末尾が /iMak で /iMak_xxx ではない)
case "$WORKTREE_TOPLEVEL" in
    *"/dev/iMak"|*"/dev/iMak/")
        IS_HQ_HOME=1
        ;;
    *)
        IS_HQ_HOME=0
        ;;
esac

if [ "$IS_HQ_HOME" = "1" ]; then
    CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED")
    if [ "$CURRENT_BRANCH" != "master" ]; then
        echo ""
        echo "[pre-commit] ❌ 本元 worktree (C:/dev/iMak/) では master 以外で commit 禁止"
        echo "[pre-commit]    現在のブランチ: $CURRENT_BRANCH"
        echo "[pre-commit]    理由: 5/3, 5/4 朝事故 (master→他branch checkout で別セッションの作業が誤 branch に乗る) の物理再発防止"
        echo "[pre-commit]"
        echo "[pre-commit]    対処方法:"
        echo "[pre-commit]      A. Catalog Claude / Inventory / Harvest / Revise の作業"
        echo "[pre-commit]         → 専用 worktree で実行"
        echo "[pre-commit]         cd C:/dev/iMak_catalog/  (or _inventory / _harvest / _revise)"
        echo "[pre-commit]      B. HQ / Advisor の作業 → master に戻る"
        echo "[pre-commit]         cd C:/dev/iMak/ && git checkout master"
        echo "[pre-commit]      C. 緊急回避 (使用厳禁): git commit --no-verify"
        echo ""
        exit 1
    fi
fi

# ============================================================================
# (2) テスト走行 — **その worktree が持っているものだけ** 走らせる
# ============================================================================
# ★2026-08-12: 従来は全 worktree で `tests/ iMakHQ/tests/` (= monorepo 全体) を走らせていた。
#   linked worktree にはその branch の**古いコピー**が入っているため、自分が触っていない
#   プロジェクトのテストで赤くなり、gate が最初から機能していなかった。
#   実測 (2026-08-08): 本元 master は 2029 passed / 0 failed、同じスコープが dedupe worktree では
#   6 failed + 6 errors (montbell の import 時 TypeError / FVF 0.14 vs 0.1325 / 一番くじ N105 等)。
#   結果、重複くんは 8/04 から commit できず、8/08 に --no-verify を例外許可して通した。
#   リバイスくんも同じ理由で daily_report 1行の commit すら通せていない (561 commit 遅れ)。
#
#   → 走らせるのは **その worktree の担当分だけ**。他人のプロジェクトの stale なテストで
#     止めない。本元 (HQ/Advisor) は従来どおり monorepo 全体を走らせる。
case "$WORKTREE_TOPLEVEL" in
    *"/dev/iMak"|*"/dev/iMak/")     SUITES="tests/ iMakHQ/tests/" ;;
    *"/dev/iMak_catalog"*)          SUITES="iMakCatalog/tests" ;;
    *"/dev/iMak_dedupe"*)           SUITES="iMakDedupe/tests" ;;
    *"/dev/iMak_harvest"*)          SUITES="iMakHarvest/tests" ;;
    *"/dev/iMak_revise"*)           SUITES="iMakRevise/tests" ;;
    *"/dev/iMak_inventory"*)        SUITES="iMakInventory/tests" ;;
    *)                              SUITES="" ;;
esac

# 実在するものだけに絞る (branch によって dir が無いことがある)
FOUND=""
for s in $SUITES; do
    [ -d "$s" ] && FOUND="$FOUND $s"
done

if [ -n "$FOUND" ]; then
    echo "[pre-commit] Running tests:$FOUND"
    PYTHONIOENCODING=utf-8 python -m pytest $FOUND --tb=short -q
    RESULT=$?

    if [ $RESULT -ne 0 ]; then
        echo ""
        echo "[pre-commit] ❌ TESTS FAILED. Commit aborted."
        echo "[pre-commit]    Fix the failing tests, then re-attempt commit."
        echo "[pre-commit]    Bypass (use ONLY in emergency): git commit --no-verify"
        exit 1
    fi
else
    # ★silent に素通りさせない。gate が無い状態は必ず見えるようにする (fail-OPEN を隠さない)
    echo ""
    echo "[pre-commit] ⚠️  この worktree にはテスト suite が見つかりません: $WORKTREE_TOPLEVEL"
    echo "[pre-commit]    探した場所: $SUITES"
    echo "[pre-commit]    **テスト gate 無しで commit します**。suite を用意してください。"
    echo ""
fi

# ============================================================================
# (3) Inventory cycle 起動ゲートの二重化 (2026-06-21, Inventory→HQ 依頼)
# ============================================================================
# pre-commit と cycle 起動ゲートが別物だったため、commit は通るのに在庫巡回が止まる穴があり、
# HIGH/LOW 在庫監視が3日間 silent 停止した (真因 commit a12b776)。在庫 worktree のコミットは
# run_cycle.py の precheck と **完全に同一の offline ゲート** を commit 時にも通し、cycle を
# 止める変更を物理的に弾く。これで「commit が通る ⟺ cycle が起動できる」を構造保証する。
# 前提: Inventory が検体不在 = skip でなく fail 化済 (commit 5e6c79d) → skip 素通りの穴は閉済。
case "$WORKTREE_TOPLEVEL" in
    *"/dev/iMak_inventory"*)
        echo "[pre-commit] Running Inventory cycle-precheck (offline gate)..."
        if ! ( cd "$WORKTREE_TOPLEVEL/iMakInventory" && \
               PYTHONIOENCODING=utf-8 python -m pytest tests/ -m offline -q --tb=short --no-header ); then
            echo ""
            echo "[pre-commit] ❌ Inventory offline gate FAILED — このcommitは在庫巡回を止めます。"
            echo "[pre-commit]    run_cycle.py の precheck と同一ゲート。先に offline テストを直してください。"
            echo "[pre-commit]    Bypass (使用厳禁): git commit --no-verify"
            exit 1
        fi
        echo "[pre-commit] ✅ Inventory offline gate passed."
        ;;
esac

echo "[pre-commit] ✅ All tests passed."
exit 0
