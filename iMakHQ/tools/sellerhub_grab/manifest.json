{
  "manifest_version": 3,
  "name": "Seller Hub レポート取り",
  "version": "3.9",
  "description": "Seller Hub のファネル用レポートを出品くん Console の起動時 (1日1回) に自動で作って落とす",
  "permissions": [
    "tabs",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/sh/reports/downloads*",
        "https://www.ebay.com/sh/performance*",
        "https://www.ebay.com/sh/lst/active*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jp.mercari.com/mypage/purchases*",
        "https://login.jp.mercari.com/*"
      ],
      "js": [
        "mercari_buys.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ebay-jp.orangeconnex.com/*"
      ],
      "js": [
        "cpass_fees.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8770/*"
  ]
}
